# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/make_model

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback

# Frontend URL (for redirect after OAuth)
FRONTEND_URL=http://localhost:3000

# Application
DEBUG=true
APP_NAME=Make Model API
API_V1_PREFIX=/api
