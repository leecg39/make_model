{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "defer_loading": true
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "defer_loading": true
    },
    "qmd": {
      "command": "/Users/user01/.bun/bin/qmd",
      "args": [
        "mcp"
      ]
    }
  }
}